# Database connection.
# Local/dev default is SQLite (zero setup). For the target BFSI deployment,
# point this at Oracle 11g, e.g.:
#   oracle+oracledb://ezpay_user:password@host:1521/?service_name=ORCL
DATABASE_URL=sqlite:///./ezpay.db

# JWT auth
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Symmetric key used by EncryptionService to encrypt sensitive fields at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
